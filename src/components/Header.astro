---
import { Icon } from 'astro-icon/components';
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  anchorFor,
  localeLabels,
  localeShortLabels,
  locales,
  sectionAnchors,
  type Locale,
} from '../lib/i18n';
interface Props {
  links: { label: string; href: string }[];
  brand: string;
  availability: string;
  navLabel: string;
  ui: {
    menuLabel: string;
    terminalPrompt: string;
    themeToggleLabel: string;
    themeToggleTitle: string;
    localeSwitcherLabel?: string;
  };
  locale: Locale;
}
const { links, brand, availability, navLabel, ui, locale } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-identity">
      <a class="header-brand" href={`#${anchorFor(locale, 'hero')}`} aria-label={brand}>
        {brand}
      </a>
      <div class="header-availability">
        <span>{availability}</span>
      </div>
    </div>
    <div class="header-actions">
      <nav class="header-nav" id="header-nav" aria-label={navLabel}>
        <div class="mobile-terminal-bar" aria-hidden="true">
          <span class="terminal-circles">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>{ui.terminalPrompt}</span>
        </div>
        {links.map((link: any) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <div
        class="locale-switch"
        role="group"
        aria-label={ui.localeSwitcherLabel ?? 'Language'}
        data-locale-switch
        data-current-locale={locale}
        data-anchors={JSON.stringify(sectionAnchors)}
      >
        {locales.map((code) => (
          <a
            href={getRelativeLocaleUrl(code)}
            lang={code}
            hreflang={code}
            class:list={['locale-switch-link', { 'is-active': code === locale }]}
            aria-current={code === locale ? 'true' : undefined}
            title={localeLabels[code]}
            data-locale-link
            data-locale={code}
          >
            {localeShortLabels[code]}
          </a>
        ))}
      </div>
      <button
        class="theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label={ui.themeToggleLabel}
        title={ui.themeToggleTitle}
        data-theme-toggle
      >
        <Icon name="tabler:sun" size={15} class="theme-icon theme-icon-sun" />
        <Icon name="tabler:moon" size={15} class="theme-icon theme-icon-moon" />
        <span class="theme-toggle-thumb" aria-hidden="true"></span>
      </button>
      <button
        class="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="header-nav"
      >
        <Icon name="tabler:terminal-2" size={16} />
        <span>{ui.menuLabel}</span>
        <i aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const systemTheme = window.matchMedia('(prefers-color-scheme: light)');

  const readStoredTheme = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  const syncThemeToggle = () => {
    themeToggle?.setAttribute('aria-checked', String(root.dataset.theme === 'light'));
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    syncThemeToggle();
  };

  syncThemeToggle();

  themeToggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    applyTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* sin persistencia: el tema se mantiene solo en esta sesión */
    }
  });

  // Sin preferencia guardada, el tema sigue al sistema en caliente.
  systemTheme.addEventListener('change', (event) => {
    if (readStoredTheme()) return;
    applyTheme(event.matches ? 'light' : 'dark');
  });

  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.header-nav a[href^="#"]')];
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href')!))
    .filter((section): section is HTMLElement => section !== null);
  const header = document.querySelector<HTMLElement>('.site-header');

  // Marca el último enlace cuya sección ya pasó la línea de referencia.
  // Si ninguna lo ha hecho (hero), no queda ningún enlace activo.
  const setActiveLink = () => {
    const line = (header?.offsetHeight ?? 0) + window.innerHeight * 0.3;
    let current: HTMLElement | null = null;

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= line) current = section;
    }

    for (const link of navLinks) {
      const active = current !== null && link.hash === `#${current.id}`;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  let frame = 0;
  const scheduleActiveLink = () => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      setActiveLink();
    });
  };

  setActiveLink();
  window.addEventListener('scroll', scheduleActiveLink, { passive: true });
  window.addEventListener('resize', scheduleActiveLink);

  const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const headerNav = document.querySelector<HTMLElement>('.header-nav');

  const closeMenu = () => {
    menuToggle?.setAttribute('aria-expanded', 'false');
    headerNav?.classList.remove('is-open');
  };

  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    headerNav?.classList.toggle('is-open', !isOpen);
  });

  headerNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  // Selector de idioma: al cambiar de idioma se conserva la sección visible
  // traduciendo el ancla actual a su equivalente en el idioma destino.
  const localeSwitch = document.querySelector<HTMLElement>('[data-locale-switch]');
  const anchors = JSON.parse(localeSwitch?.dataset.anchors ?? '{}') as Record<
    string,
    Record<string, string>
  >;
  const currentLocale = localeSwitch?.dataset.currentLocale ?? '';

  localeSwitch?.querySelectorAll<HTMLAnchorElement>('[data-locale-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const targetLocale = link.dataset.locale;
      if (!targetLocale || !anchors[currentLocale] || !anchors[targetLocale]) return;

      const hash = window.location.hash.replace('#', '');
      if (!hash) return;

      const section = Object.keys(anchors[currentLocale]).find(
        (key) => anchors[currentLocale][key] === hash,
      );
      if (!section) return;

      const targetHash = anchors[targetLocale][section];
      if (!targetHash) return;

      event.preventDefault();
      window.location.href = `${link.getAttribute('href')}#${targetHash}`;
    });
  });
</script>
