---
import { Icon } from 'astro-icon/components';
interface Props { project: any; reverse?: boolean }
const { project, reverse = false } = Astro.props;
---
<article class:list={['project-card', { reverse }]}>
	<div class="window-bar"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span class="window-filename">{project.path}</span><span class="window-status">{project.status}</span></div>
	<div class="project-body"><div class="project-visual"><img src={project.image} alt={project.imageAlt} loading="lazy"/><span class="visual-label">{project.technologies.join(' // ')}</span><dl>{project.metrics.map((metric: any) => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl></div>
		<div class="project-copy"><p class="eyebrow">{project.category}</p><h3>{project.name}</h3><p>{project.description}</p><ul>{project.highlights.map((item: string) => <li>{item}</li>)}</ul><div class="tag-list">{project.technologies.map((tech: string) => <span>{tech}</span>)}</div><a class="text-link" href={project.href}>{project.linkLabel} <Icon name="tabler:arrow-up-right" size={16} /></a></div>
	</div>
</article>
