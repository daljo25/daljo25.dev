---
import { Icon } from 'astro-icon/components';
interface Props {
  links: { label: string; href: string }[];
  brand: string;
  availability: string;
  navLabel: string;
}
const { links, brand, availability, navLabel } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-identity">
      <a class="header-brand" href="#sobre-mi" aria-label={brand}>
        {brand}
      </a>
      <div class="header-availability">
        <span>{availability}</span>
      </div>
    </div>
    <div class="header-actions">
      <nav class="header-nav" id="header-nav" aria-label={navLabel}>
        <div class="mobile-terminal-bar" aria-hidden="true">
          <span class="terminal-circles"><i></i><i></i><i></i></span>
          <span>daljo25@portfolio:~</span>
        </div>
        {links.map((link: any) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <button
        class="theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Tema claro"
        title="Cambiar tema"
        data-theme-toggle
      >
        <Icon name="tabler:sun" size={15} class="theme-icon theme-icon-sun" />
        <Icon name="tabler:moon" size={15} class="theme-icon theme-icon-moon" />
        <span class="theme-toggle-thumb" aria-hidden="true"></span>
      </button>
      <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="header-nav">
        <Icon name="tabler:terminal-2" size={16} />
        <span>MENU</span>
        <i aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const systemTheme = window.matchMedia('(prefers-color-scheme: light)');

  const readStoredTheme = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  const syncThemeToggle = () => {
    themeToggle?.setAttribute('aria-checked', String(root.dataset.theme === 'light'));
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    syncThemeToggle();
  };

  syncThemeToggle();

  themeToggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    applyTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* sin persistencia: el tema se mantiene solo en esta sesión */
    }
  });

  // Sin preferencia guardada, el tema sigue al sistema en caliente.
  systemTheme.addEventListener('change', (event) => {
    if (readStoredTheme()) return;
    applyTheme(event.matches ? 'light' : 'dark');
  });

  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.header-nav a[href^="#"]')];
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href')!))
    .filter((section): section is HTMLElement => section !== null);
  const header = document.querySelector<HTMLElement>('.site-header');

  // Marca el último enlace cuya sección ya pasó la línea de referencia.
  // Si ninguna lo ha hecho (hero), no queda ningún enlace activo.
  const setActiveLink = () => {
    const line = (header?.offsetHeight ?? 0) + window.innerHeight * 0.3;
    let current: HTMLElement | null = null;

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= line) current = section;
    }

    for (const link of navLinks) {
      const active = current !== null && link.hash === `#${current.id}`;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  let frame = 0;
  const scheduleActiveLink = () => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      setActiveLink();
    });
  };

  setActiveLink();
  window.addEventListener('scroll', scheduleActiveLink, { passive: true });
  window.addEventListener('resize', scheduleActiveLink);

  const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const headerNav = document.querySelector<HTMLElement>('.header-nav');

  const closeMenu = () => {
    menuToggle?.setAttribute('aria-expanded', 'false');
    headerNav?.classList.remove('is-open');
  };

  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    headerNav?.classList.toggle('is-open', !isOpen);
  });

  headerNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
