---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
interface Props {
  data: any;
  projects: any[];
  outputLabel: string;
}
const { data, projects, outputLabel } = Astro.props;
const orderedProjects = [...projects].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section id="proyectos" class="page-section">
  <SectionHeading
    number={data.number}
    title={data.sectionTitle}
    heading={data.heading}
    summary={data.summary}
  />
  {orderedProjects.map((project, index) => (
    <ProjectCard project={project.data} reverse={index % 2 === 1} outputLabel={outputLabel} />
  ))}
</section>
