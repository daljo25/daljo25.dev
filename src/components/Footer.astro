---
import { Icon } from 'astro-icon/components';
interface Props {
  status: string;
  socials: { label: string; href: string }[];
  socialsLabel: string;
  copyright: string;
  build: string;
}
const { status, socials, socialsLabel, copyright, build } = Astro.props;
const socialIcons: Record<string, string> = {
  GitHub: 'tabler:brand-github',
  'X / Twitter': 'tabler:brand-x',
  Discord: 'tabler:brand-discord',
};
---

<footer class="site-footer">
  <div class="footer-top">
    <span class="availability">
      <i></i>
      {status}
    </span>
    <nav aria-label={socialsLabel}>
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noreferrer">
          <Icon name={socialIcons[social.label] ?? 'tabler:link'} size={16} />
          {social.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="footer-bottom">
    <p>{copyright}</p>
    <span>{build}</span>
  </div>
</footer>
