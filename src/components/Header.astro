---
import { Icon } from 'astro-icon/components';
interface Props { links: { label: string; href: string }[]; brand: string; cta: string }
const { links, brand, cta } = Astro.props;
---
<header class="site-header">
	<a class="brand" href="#inicio" aria-label={brand}>{brand}<span>_</span></a>
	<nav aria-label="Navegación principal">{links.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
	<a class="button button-primary header-cta" href="#contacto">{cta} <Icon name="tabler:arrow-up-right" size={16} /></a>
</header>
