---
import DevFoto from './DevFoto.astro';
import { Icon } from 'astro-icon/components';
import { anchorFor, toLocale } from '../lib/i18n';
interface Props {
  data: any;
  socials: { label: string; href: string }[];
}
const { data, socials } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const projectsAnchor = anchorFor(locale, 'projects');
const contactAnchor = anchorFor(locale, 'contact');
---

<section id={anchorFor(locale, 'hero')} class="page-section hero-section">
  <div class="hero-copy">
    <p class="availability">
      <i></i>
      {data.availability}
    </p>
    <h1>
      {data.role} <span>{data.highlight}</span> {data.titleEnd}
    </h1>
    <p class="hero-lead" set:html={data.pitch} />
    <div class="hero-actions">
      <a class="button button-primary" href={`#${projectsAnchor}`}>
        {data.primaryCta} <Icon name="tabler:arrow-down" size={18} />
      </a>
      <a class="button button-secondary" href={`#${contactAnchor}`}>
        {data.secondaryCta} <Icon name="tabler:arrow-up-right" size={18} />
      </a>
    </div>
    <div class="hero-socials">
      <span>{data.socialLabel}</span>
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noreferrer">
          {social.label}
        </a>
      ))}
    </div>
  </div>
  <DevFoto {...data.photo} />
</section>
